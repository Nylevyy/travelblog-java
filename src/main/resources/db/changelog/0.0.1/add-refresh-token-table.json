{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "0.0.1-1",
        "author": "Nylevyy",
        "preConditions": [
          {
            "onFail": "CONTINUE",
            "not": {
              "tableExists": {
                "tableName": "refresh_token"
              }
            }
          }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "refresh_token",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "UUID",
                    "defaultValueComputed": "gen_random_uuid()",
                    "constraints": {
                      "nullable": false,
                      "primaryKey": true,
                      "updatable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "token",
                    "type": "TEXT",
                    "constraints": {
                      "unique": true,
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "user_id",
                    "type": "UUID",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "expires_at",
                    "type": "TIMESTAMP"
                  }
                },
                {
                  "column": {
                    "name": "user_version",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "created_at",
                    "type": "TIMESTAMP",
                    "defaultValueComputed": "now()",
                    "constraints": {
                      "nullable": false,
                      "updatable": false
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "0.0.1-2",
        "author": "Nylevyy",
        "preConditions": [
          {
            "onFail": "HALT",
            "and": [
              {
                "tableExists": {
                  "tableName": "refresh_token"
                }
              },
              {
                "tableExists": {
                  "tableName": "users"
                }
              }
            ]
          }
        ],
        "changes": [
          {
            "addForeignKeyConstraint": {
              "baseColumnNames": "user_id",
              "baseTableName": "refresh_token",
              "constraintName": "fk_refresh_token_users",
              "referencedColumnNames": "id",
              "referencedTableName": "users",
              "onDelete": "CASCADE"
            }
          }
        ]
      }
    }
  ]
}
